generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String             @id @default(cuid())
  name          String?
  email         String             @unique
  password      String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  expenses      Expense[]
  budgets       Budget[]
  incomes       Income[]
  accounts      Account[]
  recurring     RecurringExpense[]
  notifications Notification[]
  borrowLend    BorrowLend[]
}

model Expense {
  id            String   @id @default(cuid())
  userId        String
  amount        Decimal  @db.Decimal(12, 2)
  merchant      String
  category      String
  paymentMethod String
  date          DateTime
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Budget {
  id        String   @id @default(cuid())
  userId    String
  category  String
  amount    Decimal  @db.Decimal(12, 2)
  month     Int
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, month, year])
}

model Income {
  id        String   @id @default(cuid())
  userId    String
  source    String
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime
  category  String   @default("Salary")
  notes     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Account {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String
  balance   Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecurringExpense {
  id            String   @id @default(cuid())
  userId        String
  merchant      String
  amount        Decimal  @db.Decimal(12, 2)
  category      String
  paymentMethod String
  frequency     String
  nextDate      DateTime
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model BorrowLend {
  id          String                @id @default(cuid())
  userId      String
  person      String
  phone       String?
  type        String
  amount      Decimal               @db.Decimal(12, 2)
  startDate   DateTime
  dueDate     DateTime?
  notes       String?
  status      String                @default("PENDING")
  settledAt   DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  repayments  BorrowLendRepayment[]

  @@index([userId, dueDate])
  @@index([userId, person])
}

model BorrowLendRepayment {
  id           String     @id @default(cuid())
  borrowLendId String
  amount       Decimal    @db.Decimal(12, 2)
  date         DateTime
  notes        String?
  createdAt    DateTime   @default(now())
  borrowLend   BorrowLend @relation(fields: [borrowLendId], references: [id], onDelete: Cascade)

  @@index([borrowLendId, date])
}
